# =============================================================================
# Eléctrico Edison Pino — Variables de Entorno
# =============================================================================

# URL pública de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (cliente navegador y SSR)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de servicio para operaciones administrativas de servidor (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL base de la aplicación (para redirecciones de Auth y enlaces en correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
